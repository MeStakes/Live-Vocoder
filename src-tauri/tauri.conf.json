{
  "productName": "Live Vocoder",
  "version": "0.1.0",
  "identifier": "com.keopees.live-vocoder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Live Vocoder",
        "width": 1440,
        "height": 820,
        "minWidth": 1280,
        "minHeight": 720,
        "maximized": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "Live Vocoder",
      "hardenedRuntime": false
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCNDA1NDU2NkM5MUU3RjEKUldUeDU1RnNWbFJBNjNvdUlNVXQySUtuR1d0NmQ1K2I3TExjbDNRR2x6WEF6dGRhdU9mYTRZc0MK",
      "endpoints": [
        "https://github.com/MeStakes/Live-Vocoder/releases/latest/download/latest.json"
      ]
    }
  }
}
